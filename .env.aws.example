# ============================================
# AWS CONFIGURATION FOR PRELANDER HOSTING
# ============================================
# IMPORTANTE: Copia estas líneas a tu archivo .env.local
# y reemplaza los valores con tus credenciales reales de AWS

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=AKIA_REEMPLAZA_CON_TU_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REEMPLAZA_CON_TU_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=landertag.com

# AWS CloudFront Configuration (opcional - para URLs más cortas y mejor rendimiento)
# Ejemplo: d1234abcd5678.cloudfront.net
# Si lo dejas vacío, usará URLs directas de S3
AWS_CLOUDFRONT_DOMAIN=

# AWS SES Configuration (para enviar emails)
AWS_SES_SENDER_EMAIL=contact@nanokit.io
AWS_SES_REGION=us-east-1

# ============================================
# INSTRUCCIONES:
# ============================================
# 1. Abre el archivo .env.local en la raíz del proyecto
# 2. Copia las líneas de AWS de arriba
# 3. Reemplaza:
#    - AKIA_REEMPLAZA_CON_TU_ACCESS_KEY → Tu Access Key ID de AWS
#    - REEMPLAZA_CON_TU_SECRET_KEY → Tu Secret Access Key de AWS
#    - manuportuguez@gmail.com → Tu email verificado en Amazon SES
# 4. Guarda el archivo
# 5. Reinicia el servidor: npm run dev
